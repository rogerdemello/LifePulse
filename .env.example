# LifePulse - copy to .env and fill in. .env is gitignored; never commit real
# values. Everything here is optional except SECRET_KEY, and the app degrades
# honestly without each one rather than breaking.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Flask session signing key. In production the app refuses to start without it
# rather than falling back to a predictable default.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Nutrition lookup (/nutrition)
# ---------------------------------------------------------------------------

# USDA FoodData Central. Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Without it the lookup page says so instead of pretending to have no results.
USDA_API_KEY=

# ---------------------------------------------------------------------------
# Azure OpenAI  (optional)
#
# Used for exactly one thing: routing the free-text "what have you noticed?"
# box to the right assessment. Without it that box falls back to keyword
# matching and nothing else changes.
#
# What is sent: the sentence typed into that box, and nothing else.
# What is never sent: any assessment answer, any result, any vital sign. The
# result wording is generated offline by ml_model/generate_phrasings.py and
# committed, so no health data leaves the server at runtime. Emergency
# detection runs locally on keyword rules first and cannot be overridden by
# the model, so a red flag never depends on a third party being reachable.
#
# All five must be set for routing to switch on; /healthz reports which are.
# ---------------------------------------------------------------------------

# https://<your-resource>.openai.azure.com   (no trailing slash needed)
AZURE_OPENAI_ENDPOINT=

AZURE_OPENAI_API_KEY=

# The *deployment* name you chose in Azure, not the model name.
AZURE_OPENAI_DEPLOYMENT=

AZURE_OPENAI_API_VERSION=2024-10-21

# Seconds before giving up and falling back to keyword matching.
AZURE_OPENAI_TIMEOUT=6

# ---------------------------------------------------------------------------
# Error monitoring (optional)
# ---------------------------------------------------------------------------

# Only used if sentry-sdk is installed too (pip install sentry-sdk). Request
# bodies are never transmitted -- see app/observability.py for what is stripped.
SENTRY_DSN=
