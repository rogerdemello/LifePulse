# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Flask session signing key. Required in production: the app refuses to start
# without it when FLASK_ENV=production or RENDER is set, rather than falling
# back to a predictable default. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | production
FLASK_ENV=development

# USDA FoodData Central key, used only by /nutrition/. Free tier at
# https://fdc.nal.usda.gov/api-key-signup.html
# Without it, the nutrition lookup page returns "no food data found".
USDA_API_KEY=

# Optional error monitoring. Only used if sentry-sdk is also installed
# (pip install sentry-sdk) -- it is deliberately not a hard dependency, and
# request bodies are never transmitted.
# SENTRY_DSN=

# Optional: Azure OpenAI, used only to route the free-text "what's bothering
# you" box on /start to the right assessment. Without it that box falls back to
# keyword matching and everything else is unchanged.
#
# Assessment answers and results are never sent -- the result wording is
# generated offline by ml_model/generate_phrasings.py and committed.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_TIMEOUT=6
